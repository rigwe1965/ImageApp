# ImageApp settings. Copy to .env (run.py and wsgi.py load it) and uncomment what you want to change.
# Every line below shows the default, so copying this file as it is changes nothing.
# tests/test_env_example.py fails when the code reads a variable that is not listed here.

# Flask secret key. Unset = a new random value at every start (nothing in the app needs it to stay the same).
# SECRET_KEY=

# Size limits (bytes unless noted)
# MAX_CONTENT_LENGTH=104857600          # whole request, 100 MB (Flask answers 413 above it)
# MAX_SINGLE_FILE_SIZE=26214400         # one file, 25 MB
# MAX_IMAGE_DIMENSION_PIXELS=64000000   # width x height of one image
# MAX_BATCH_FILES=30                    # files per batch upload
# MAX_TOTAL_SESSION_BYTES=524288000     # all live sessions together, 500 MB (bounds memory)

# Storage and clean-up
# IMAGEAPP_TEMP_DIR=                    # where originals are kept; default: <system temp>/imageapp
# SESSION_TTL_SECONDS=2700              # an idle session is removed after 45 minutes
# CLEANUP_INTERVAL_SECONDS=300          # how often the clean-up runs

# Rate limits (Flask-Limiter syntax). "Heavy" = anything that decodes or re-encodes an image.
# RATELIMIT_ENABLED=1                   # 0, false or no turns them off
# RATELIMIT_DEFAULT=300 per minute
# RATELIMIT_UPLOAD=20 per minute
# RATELIMIT_HEAVY=60 per minute
# RATELIMIT_STORAGE_URI=memory://       # behind several workers or a proxy, use a shared store such as redis://...

# Logging
# LOG_LEVEL=INFO
# LOG_DIR=logs

# Development only (run.py): 1, true or yes turns on Flask's debugger. Never in production.
# FLASK_DEBUG=
